{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photonic Photos",
  "version": "0.1.0",
  "identifier": "com.photonic.photos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Photonic Photos",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/photonic-backend"],
    "resources": [
      "resources/exiftool/",
      "resources/runtime/",
      "resources/photonic-backend-0.1.0.jar"
    ]
  }
}
